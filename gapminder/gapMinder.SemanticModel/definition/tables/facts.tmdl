table facts
	lineageTag: a5241ec6-e0e6-4397-9b6e-4910745ff300

	measure PIB_per_Capita =
			
			CALCULATE(
			    SUM('facts'[value]),
			    'facts'[indicator_id] = "gdppercapita_us_inflation_adjusted" -- Garante o nome exato da tua dimensão
			)
		lineageTag: 8365834c-94bc-4f2e-8356-204fad8e545c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Esperanca_Vida_F =
			
			CALCULATE(
			    SUM('facts'[value]),
			    'facts'[indicator_id] = "life_expectancy_female"
			)
		lineageTag: fa3e14ad-d7a6-45f4-8c04-a2016184630e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Populacao Total' =
			
